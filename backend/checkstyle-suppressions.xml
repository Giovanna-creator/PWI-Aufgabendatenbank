<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Suppress Javadoc checks in test code -->
    <suppress files="[\\/]src[\\/]test[\\/]" checks="Javadoc*"/>
    <suppress files="[\\/]src[\\/]test[\\/]" checks="NonEmptyAtclauseDescription"/>
    <suppress files="[\\/]src[\\/]test[\\/]" checks="SummaryJavadoc"/>
    <suppress files="[\\/]src[\\/]test[\\/]" checks="AtclauseOrder"/>
</suppressions>
